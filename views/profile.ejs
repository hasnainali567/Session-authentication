<%- include('partials/header') %>

<body class="bg-light">
    <nav class="navbar navbar-light bg-white shadow-sm px-4">
        <span class="navbar-brand fw-bold">MyApp</span>
        <a href="/logout" class="btn btn-outline-danger">Logout</a>
    </nav>
    
    <div class="container d-flex justify-content-center mt-5">
        <div class="card shadow p-4" style="width: 450px; border-radius: 18px;">
            <h3 class="text-center mb-4 fw-bold text-primary">Your Profile</h3>
            
            <p><strong>Name:</strong> <%= user.name %></p>
            <p><strong>Email:</strong> <%= user.email %></p>
            
            <div class="border-top mt-3 pt-3 text-center">
                <a href="/logout" class="btn btn-outline-danger">Logout</a>
            </div>
        </div>
    </div>
</body>
</html>
